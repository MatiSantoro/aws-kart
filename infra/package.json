{
  "name": "aws-kart-infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for AWS Kart VR — Meta Quest racing game with Bedrock commentary",
  "main": "bin/aws-kart.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "npx cdk deploy --require-approval never",
    "destroy": "npx cdk destroy",
    "synth": "npx cdk synth",
    "diff": "npx cdk diff",
    "test": "jest"
  },
  "dependencies": {
    "aws-cdk-lib": "2.130.0",
    "constructs": "10.3.0"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "aws-cdk": "2.130.0",
    "typescript": "5.4.0",
    "ts-node": "10.9.2",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.2"
  }
}
